# ---- Keys and secrets: never commit ----
.env
.env.*
!.env.example
**/.env
.claude/settings.local.json

# ---- Data: never commit (licensed for hackathon use only, or downloaded with our keys) ----
# CoStar's data kit (property records, listings, tenants)
costar-hackathon-kit/
# Shared cache: Matterport scans, panoramas, point clouds, Vexcel imagery, CoStar records per model
data/
# Any stray data files, wherever they end up
*.jsonl
*.csv
*.npy
*.ply
*.xyz
*.zip
*.dxf

# Generated audio for the listening demo
frontend/public/audio/*.wav

# ---- Build and OS clutter ----
__pycache__/
*.pyc
.venv/
node_modules/
frontend/dist/
.DS_Store

# Local YOLO configuration and weights (never served as scan data)
.vision-cache/
